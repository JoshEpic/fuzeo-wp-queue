{
    "name": "fuzeowp/queue",
    "description": "Durable queue infrastructure for WordPress plugin developers.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "queue",
        "jobs",
        "background",
        "fuzeo"
    ],
    "homepage": "https://github.com/fuzeowp/queue",
    "authors": [
        {
            "name": "Fuzeo",
            "homepage": "https://fuzeo.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Fuzeo\\Queue\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Fuzeo\\Queue\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "phpcs": "phpcs",
        "check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
