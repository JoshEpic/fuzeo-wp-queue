{
    "name": "fuzeowp/queue",
    "description": "Real background job infrastructure for WordPress. Durable queues, persistent workers, retries, scheduling, concurrency, observability, and more.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "wordpress",
        "queue",
        "jobs",
        "background",
        "workers",
        "redis",
        "mysql",
        "fuzeo"
    ],
    "homepage": "https://github.com/JoshEpic/fuzeo-wp-queue",
    "authors": [
        {
            "name": "JoshEpic",
            "homepage": "https://joshdavies.me"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Fuzeo\\Queue\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Fuzeo\\Queue\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "phpcs": "phpcs",
        "check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "suggest": {
        "ext-redis": "Required for the Redis queue driver (PhpRedis 5.3+ recommended).",
        "ext-pcntl": "Enables cooperative job timeouts and SIGTERM handling in CLI workers."
    },
    "support": {
        "issues": "https://github.com/JoshEpic/fuzeo-wp-queue/issues",
        "source": "https://github.com/JoshEpic/fuzeo-wp-queue",
        "docs": "https://github.com/JoshEpic/fuzeo-wp-queue/blob/main/README.md"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
