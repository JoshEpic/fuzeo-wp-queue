parameters:
    level: 8
    phpVersion: 80100
    paths:
        - src
        - tests
    tmpDir: /tmp/phpstan-fuzeo-queue
    treatPhpDocTypesAsCertain: false
    bootstrapFiles:
        - tests/Support/WordPressStubs.php
        - tests/Support/WpdbStub.php
        - tests/Support/RedisStubs.php
    excludePaths:
        - tests/Support/RedisStubs.php
        - tests/WordPress
        - tests/bootstrap.php
